{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yourquest:offline:adaptive-output:0.2.0",
  "type": "object",
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "none",
        "incubate",
        "propose"
      ]
    },
    "interpretation": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "supporting_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "summary",
        "confidence",
        "supporting_evidence_ids"
      ],
      "additionalProperties": false
    },
    "opportunity": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "skill",
            "class_evolution",
            "title",
            "item",
            "quest",
            "npc_interaction",
            "relationship",
            "world_event",
            "identity"
          ]
        },
        "rarity": {
          "type": "string",
          "enum": [
            "personalized",
            "rare",
            "unique",
            "legendary_chain"
          ]
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "mechanical_template_id": {
          "type": "string",
          "pattern": "^fixture:[a-z0-9:_-]+$"
        },
        "destination_id": {
          "type": "string",
          "pattern": "^fixture:[a-z0-9:_-]+$"
        },
        "canonical_entity_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "canonical_fact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "objective_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "mechanic_tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "diegetic_reason": {
          "type": "string",
          "minLength": 1
        },
        "future_hooks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "offer_state": {
          "const": "proposal_only"
        }
      },
      "required": [
        "kind",
        "rarity",
        "identity",
        "mechanical_template_id",
        "destination_id",
        "canonical_entity_ids",
        "canonical_fact_ids",
        "objective_ids",
        "mechanic_tags",
        "diegetic_reason",
        "future_hooks",
        "offer_state"
      ],
      "additionalProperties": false
    },
    "naming": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "ability",
            "skill",
            "spell",
            "technique",
            "title",
            "class",
            "class_evolution",
            "item",
            "weapon",
            "armor",
            "artifact",
            "quest",
            "opportunity",
            "unique_opportunity",
            "legendary_chain",
            "faction",
            "settlement",
            "npc",
            "npc_epithet",
            "discovery",
            "world_event"
          ]
        },
        "selected_name": {
          "type": "string",
          "minLength": 1
        },
        "semantic_kernel": {
          "type": "object",
          "properties": {
            "identity": {
              "type": "string",
              "minLength": 1
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "motif": {
              "type": "string",
              "minLength": 1
            },
            "consequence": {
              "type": "string",
              "minLength": 1
            },
            "context": {
              "type": "string",
              "minLength": 1
            },
            "tone": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "identity",
            "method",
            "motif",
            "consequence",
            "context",
            "tone"
          ],
          "additionalProperties": false
        },
        "candidate_families": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        },
        "parent_identity_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "naming_lineage_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "evolution_reason": {
          "type": "string"
        },
        "behavioral_delta": {
          "type": "string"
        },
        "mechanical_delta": {
          "type": "string"
        },
        "culture_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "naming_reason": {
          "type": "string",
          "minLength": 1
        },
        "presentation_only": {
          "type": "boolean"
        },
        "motifs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "accepted": {
          "const": false
        },
        "npc_parts": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "given_name": {
              "type": "string",
              "minLength": 1
            },
            "family_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "clan_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "honorific": {
              "type": [
                "string",
                "null"
              ]
            },
            "pronunciation_hint": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "given_name",
            "family_name",
            "clan_name",
            "honorific",
            "pronunciation_hint"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "category",
        "selected_name",
        "semantic_kernel",
        "candidate_families",
        "candidates",
        "parent_identity_id",
        "naming_lineage_id",
        "evolution_reason",
        "behavioral_delta",
        "mechanical_delta",
        "culture_id",
        "naming_reason",
        "presentation_only",
        "motifs",
        "accepted",
        "npc_parts"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "npc_entity_id": {
          "type": "string",
          "pattern": "^fixture:[a-z0-9:_-]+$"
        },
        "knowledge_fact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "npc_entity_id",
        "knowledge_fact_ids",
        "text"
      ],
      "additionalProperties": false
    },
    "enrichment": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "entity_id": {
          "type": "string",
          "pattern": "^fixture:[a-z0-9:_-]+$"
        },
        "canonical_fact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "entity_id",
        "canonical_fact_ids",
        "text"
      ],
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "requires_validation": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "unsupported_requests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "requires_validation",
        "unsupported_requests"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "decision",
    "interpretation",
    "opportunity",
    "naming",
    "response",
    "enrichment",
    "constraints"
  ],
  "additionalProperties": false
}
